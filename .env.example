# Copiar a .env y completar los valores. Nunca subir .env real al repositorio.

# Clave del postgres dentro del contenedor
POSTGRES_PASSWORD=postgres

# Clave para firmar los tokens JWT (importante cambiarla en producción)
JWT_SECRET_KEY=cambiar_esta_clave_secreta

# Minutos de validez de la sesión
JWT_EXPIRE_MINUTES=60

# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:8000